# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

# Django
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Default admin account created on startup
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=

# GitLab server URL and a personal/group access token with `api` scope
GITLAB_URL=http://gitlab
ACCESS_TOKEN=
# Address GitLab uses to reach the backend for webhooks
EXTERNAL_URL=web:8000

# Database (shared with the postgres container)
POSTGRES_DB=gam
POSTGRES_USER=gam
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
